# Ambiente de PRODUÇÃO — copie para `.env` na VPS e preencha os valores reais.
# Usado por docker-compose.prod.yml (backend lê via env_file).
#
#   cp .env.production.example .env
#   nano .env

# PostgreSQL — roda direto na VPS (fora do Docker), compartilhado com os
# outros apps (ecowatt, mfscars) em bancos separados. O host
# "host.docker.internal" é resolvido para o host pelo extra_hosts do
# docker-compose.prod.yml — NÃO trocar por "localhost".
DATABASE_URL=postgresql+psycopg://manutip:TROQUE_PELA_SENHA_REAL@host.docker.internal:5432/manutip

# Gerado com `python3 -c "import secrets; print(secrets.token_hex(32))"`.
# Trocar este valor invalida todas as sessões abertas.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
