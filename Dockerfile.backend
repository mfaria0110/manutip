# Backend FastAPI + uvicorn — imagem enxuta, non-root.
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# psycopg[binary] já traz o driver embutido — não precisa de libpq-dev/gcc.
COPY backend/requirements.txt ./requirements.txt
RUN pip install -r requirements.txt

COPY backend/ ./

# Usuário sem privilégios (defense-in-depth). Pasta de storage criada aqui
# (mesmo vazia) pra já existir com dono certo antes do volume nomeado do
# docker-compose ser montado em cima dela — senão o volume novo nasce
# root:root e o processo (uid 1000) não consegue gravar foto nenhuma.
RUN useradd --create-home --uid 1000 app && mkdir -p /app/storage && chown -R app:app /app
USER app

EXPOSE 8000

# DATABASE_URL, JWT_SECRET etc. vêm por env (docker-compose) — não versionar segredos.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
