# App de campo (PWA, perfil OPERACIONAL) — build no node, servido por nginx
# alpine, igual ao frontend de escritório, só que empacotado/deployado à
# parte (ver docker-compose.prod.yml e docs/deploy-vps.md).
FROM node:20-alpine AS build
WORKDIR /app

COPY app-campo/package.json app-campo/package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

COPY app-campo/ ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY docker/nginx-app-campo.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -q -O- http://127.0.0.1/campo/ >/dev/null || exit 1
